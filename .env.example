# ==============================================================================
# BIASLENS ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local to configure your local or production environment:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# Supabase Production Backend Configuration
# ------------------------------------------------------------------------------
# Find these values in your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# Optional: FastAPI Microservice (Person A / B Integration)
# ------------------------------------------------------------------------------
# Default fallback is http://localhost:8000 when Analysis Engine is set to 'fastapi'
VITE_FASTAPI_URL=http://localhost:8000
